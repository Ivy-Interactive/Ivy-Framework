<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../../Ivy/Directory.Build.props" Condition="Exists('../../../Ivy/Directory.Build.props')" />
  
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS1591;CS1573</NoWarn>
    <PackageId>Ivy</PackageId>
    <Company>Ivy</Company>
    <Description>Build Internal Applications with AI and Pure C#</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Ivy-Interactive/Ivy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ivy-Interactive/Ivy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Plugin API compatibility: compares public API against baseline to catch breaking changes -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.2.67</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup>
    <CI Condition="'$(GITHUB_ACTIONS)' == 'true'">true</CI>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(CI)' != 'true'">
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <EmbeddedResource Include="../../AGENTS.md" Link="AGENTS.md" />
    <None Include="../../AGENTS.md" Pack="true" PackagePath="" />
    <None Include="../Ivy.Docs.Shared/Docs/**/*.md" Pack="true" PackagePath="docs/generated" Visible="false" />
    <EmbeddedResource Include="../frontend/src/routing-constants.json" LogicalName="RoutingConstants" Visible="false" />
  </ItemGroup>
  
  <!--
    External widgets live under Widgets/External/<Name>/ and compile into Ivy.dll.
    Their sample apps and test suites are separate projects and must not be globbed in.
  -->
  <ItemGroup>
    <Compile Remove="Widgets/External/**/.samples/**" />
    <Compile Remove="Widgets/External/**/Tests/**" />
    <Compile Remove="Widgets/External/**/frontend/**" />
    <EmbeddedResource Remove="Widgets/External/**/.samples/**" />
    <EmbeddedResource Remove="Widgets/External/**/Tests/**" />
    <None Remove="Widgets/External/**/.samples/**" />
    <None Remove="Widgets/External/**/Tests/**" />
    <None Remove="Widgets/External/**/frontend/node_modules/**" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/datatable.proto" GrpcServices="Server" />
  </ItemGroup>

  <!-- Absorbed from Ivy.Agent.Filter (see Agent/Filter/README.md) -->
  <ItemGroup>
    <Antlr4 Include="Agent/Filter/Filters.g4">
      <Generator>MSBuild:Compile</Generator>
      <CustomToolNamespace>Ivy.Agent.Filter.Parser</CustomToolNamespace>
    </Antlr4>
    <EmbeddedResource Include="Agent/Filter/Filters.g4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Apache.Arrow" Version="22.1.0" />
    <PackageReference Include="ExcelNumberFormat" Version="1.1.0" />
    <PackageReference Include="Google.Protobuf" Version="3.33.2" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.76.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.4.1" />
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.9" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.9" />
    <!-- Lifts the transitive MessagePack 2.5.187 from SignalR.Protocols.MessagePack past GHSA-hv8m-jj95-wg3x (NU1903) -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.4.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <PackageReference Include="DeepCloner" Version="0.10.4" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.9" />
    <PackageReference Include="Ivy.SystemTextJson.JsonDiffPatch" Version="2.0.4" />
    <PackageReference Include="Ivy.NativeJsonDiff" Version="2.0.0" />
    <PackageReference Include="Ivy.DesignSystem" Version="1.1.32" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.9.0" />
    <!-- Absorbed from Ivy.Agent.Filter -->
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="12.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.4.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <!-- Absorbed from Ivy.Hooks.Pty -->
    <PackageReference Include="Porta.Pty" Version="1.0.6" />
    <!--
      Ivy.Plugin.Abstractions.dll ships inside this package (see PackPluginAbstractions below)
      rather than as a package dependency, so its own dependencies must be declared here.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ivy.Test" />
    <InternalsVisibleTo Include="Ivy.Docs" />
    <InternalsVisibleTo Include="Ivy.XamlBuilder" />
    <InternalsVisibleTo Include="Ivy.XamlBuilder.Test" />
    <InternalsVisibleTo Include="Ivy.Integration.Tests" />
    <InternalsVisibleTo Include="Ivy.IvyML" />
    <InternalsVisibleTo Include="Ivy.Hooks.Pty.Test" />
    <InternalsVisibleTo Include="Ivy.Agent.Filter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets: the assembly is packed into lib/ below instead of becoming a package dependency -->
    <ProjectReference Include="../Ivy.Plugin.Abstractions/Ivy.Plugin.Abstractions.csproj" PrivateAssets="all" />
    <!-- Built but not referenced: the output is packed into analyzers/dotnet/cs below -->
    <ProjectReference Include="../Ivy.Analyser/Ivy.Analyser.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework" />
  </ItemGroup>

  <!-- Ivy.Plugin.Abstractions is no longer published separately, so ship its assembly in lib/ -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackPluginAbstractions</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="PackPluginAbstractions">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)Ivy.Plugin.Abstractions.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Ivy.Plugin.Abstractions.xml"
                            Condition="Exists('$(OutputPath)Ivy.Plugin.Abstractions.xml')" />
    </ItemGroup>
  </Target>

  <!-- Ivy.Analyser is no longer published separately, so ship it as an analyzer inside this package -->
  <Target Name="PackIvyAnalyser" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_IvyAnalyserDll>$(MSBuildThisFileDirectory)../Ivy.Analyser/bin/$(Configuration)/netstandard2.0/Ivy.Analyser.dll</_IvyAnalyserDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(_IvyAnalyserDll)')"
           Text="Ivy.Analyser.dll not found at '$(_IvyAnalyserDll)'. It must be built before packing Ivy." />
    <ItemGroup>
      <None Include="$(_IvyAnalyserDll)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Frontend source files for incremental build detection -->
  <ItemGroup>
    <FrontendSourceFiles Include="../frontend/src/**/*" />
    <FrontendSourceFiles Include="../frontend/package.json" />
    <FrontendSourceFiles Include="../frontend/pnpm-lock.yaml" Condition="Exists('../frontend/pnpm-lock.yaml')" />
    <FrontendSourceFiles Include="../frontend/tsconfig.json" Condition="Exists('../frontend/tsconfig.json')" />
    <FrontendSourceFiles Include="../frontend/vite.config.*" />
  </ItemGroup>

  <Target Name="NpmInstall" BeforeTargets="BuildFrontend"
          Inputs="../frontend/package.json;../frontend/pnpm-lock.yaml"
          Outputs="../frontend/node_modules/.modules.yaml">
    <Exec Command="vp install -- --config.confirmModulesPurge=false" WorkingDirectory="../frontend" EnvironmentVariables="CI=$(CI)" />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="AssignTargetPaths"
          Inputs="@(FrontendSourceFiles)"
          Outputs="../frontend/dist/.build-stamp">
    <Exec Command="vp run build" WorkingDirectory="../frontend" EnvironmentVariables="CI=$(CI)" />
    <Touch Files="../frontend/dist/.build-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="EmbedFrontendResources" AfterTargets="BuildFrontend" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_FrontendDistFile Include="../frontend/dist/**/*" />
      <EmbeddedResource Include="@(_FrontendDistFile)" Visible="false"
                        LogicalName="Ivy.$([System.String]::Copy('%(Identity)').Replace('..\frontend\dist\','').Replace('../frontend/dist/','').Replace('\','.').Replace('/','.'))" />
    </ItemGroup>
  </Target>

  <!--
    External widget frontends. Each Widgets/External/<Name>/frontend is an independent vite
    bundle whose dist is embedded under the logical prefix "Ivy.widgets.<Name>.", matching the
    "widgets/<Name>/..." ScriptPath/StylePath on each [ExternalWidget] attribute. This mirrors
    Build/Ivy.ExternalWidget.targets, which remains the contract for third-party widget packages.
  -->
  <ItemGroup>
    <ExternalWidget Include="ActivityHeatmap" />
    <ExternalWidget Include="AnimatedStatusLabel" />
    <ExternalWidget Include="DiffView" />
    <ExternalWidget Include="Leaflet" />
    <ExternalWidget Include="QRCode" />
    <ExternalWidget Include="ScreenshotFeedback" />
    <ExternalWidget Include="Tiptap" />
    <ExternalWidget Include="Xterm" />
  </ItemGroup>

  <Target Name="NpmInstallExternalWidgets" BeforeTargets="BuildExternalWidgetFrontends"
          Inputs="Widgets/External/%(ExternalWidget.Identity)/frontend/package.json;Widgets/External/%(ExternalWidget.Identity)/frontend/pnpm-lock.yaml"
          Outputs="Widgets/External/%(ExternalWidget.Identity)/frontend/node_modules/.modules.yaml">
    <Exec Command="vp install -- --config.confirmModulesPurge=false"
          WorkingDirectory="Widgets/External/%(ExternalWidget.Identity)/frontend"
          EnvironmentVariables="CI=$(CI)" />
  </Target>

  <Target Name="BuildExternalWidgetFrontends" BeforeTargets="AssignTargetPaths"
          Inputs="Widgets/External/%(ExternalWidget.Identity)/frontend/src/**/*;Widgets/External/%(ExternalWidget.Identity)/frontend/package.json;Widgets/External/%(ExternalWidget.Identity)/frontend/pnpm-lock.yaml;Widgets/External/%(ExternalWidget.Identity)/frontend/tsconfig.json;Widgets/External/%(ExternalWidget.Identity)/frontend/vite.config.ts"
          Outputs="Widgets/External/%(ExternalWidget.Identity)/frontend/dist/.build-stamp">
    <Exec Command="vp build"
          WorkingDirectory="Widgets/External/%(ExternalWidget.Identity)/frontend"
          EnvironmentVariables="CI=$(CI)" />
    <Touch Files="Widgets/External/%(ExternalWidget.Identity)/frontend/dist/.build-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="EmbedExternalWidgetResources" AfterTargets="BuildExternalWidgetFrontends" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <!-- WidgetName metadata is required: an unqualified %(Filename) below would batch over ExternalWidget, not the glob -->
      <_ExternalWidgetDistFile Include="Widgets/External/%(ExternalWidget.Identity)/frontend/dist/**/*"
                               Exclude="Widgets/External/%(ExternalWidget.Identity)/frontend/dist/.build-stamp"
                               WidgetName="%(ExternalWidget.Identity)" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Include="@(_ExternalWidgetDistFile)" Visible="false"
                        LogicalName="Ivy.widgets.%(_ExternalWidgetDistFile.WidgetName).$([System.String]::Copy('%(_ExternalWidgetDistFile.RecursiveDir)').Replace('\','.').Replace('/','.'))%(_ExternalWidgetDistFile.Filename)%(_ExternalWidgetDistFile.Extension)" />
    </ItemGroup>
  </Target>

</Project>